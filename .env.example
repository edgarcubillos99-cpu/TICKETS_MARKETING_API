# Servidor
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Usuario del dashboard (login + MFA)
AUTH_USERNAME=admin
AUTH_PASSWORD=cambia-esta-clave
AUTH_EMAIL=admin@tudominio.com

# JWT (mínimo 32 caracteres)
JWT_SECRET=cambia-este-secreto-de-al-menos-32-chars
JWT_EXPIRES_IN=8h

# Base de datos MySQL remota
# DB_DATABASE = schema (SHOW DATABASES / USE ...), no el nombre de la tabla.
# La tabla tickets_osnet está definida en la entidad.
DB_HOST=tu-host-remoto
DB_PORT=3306
DB_USERNAME=usuario_remoto
DB_PASSWORD=clave_remota
DB_DATABASE=osnet
DB_SSL=true
# false si el servidor usa certificado autofirmado
DB_SSL_REJECT_UNAUTHORIZED=false

# SMTP para el código MFA
SMTP_HOST=smtp.tudominio.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario_smtp
SMTP_PASS=clave_smtp
SMTP_FROM="Tickets Dashboard <noreply@tudominio.com>"
